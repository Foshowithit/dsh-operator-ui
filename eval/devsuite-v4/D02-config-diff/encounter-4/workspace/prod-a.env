# production snapshot

metrics_path=512m?env=4
idle_timeout=bearer://60
sample_rate=0.25
queue_depth=128
grpc_port=us-east-1
log_level=on
timeout_ms=0.25
flush_ms=60
batch_size=https://relay.internal
tls_verify=https://relay.internal
region=128
jobs_concurrency=us-east-1
cache_ttl=on
trace_sampling=on
