{
  "name": "dsh-operator-ui",
  "version": "0.11.0",
  "description": "RCOS operator control surface for DeepSeek Harness: first-run receipt gate, Work spine (request → route → execution → evidence → verdict), Intelligence inventory, System panel — plus the older Runs, Summary, Git, Browser, Files, Workflows and Capabilities tabs and a Cmd+K palette. Side-loaded into the existing web UI; not a fork.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Foshowithit/dsh-operator-ui.git"
  },
  "homepage": "https://github.com/Foshowithit/dsh-operator-ui#readme",
  "bugs": {
    "url": "https://github.com/Foshowithit/dsh-operator-ui/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "fixtures",
    "system-manifest.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "operator-ui",
    "dsh-plugin",
    "rcos",
    "capability-registry"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.8"
  }
}
